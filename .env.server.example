# SkillVault on a shared server (e.g. 172.16.200.30 alongside another app)
# Copy to .env in bank.ai/ and fill in secrets before deploy:
#   cp .env.server.example .env

# --- Required for production compose (docker-compose.prod.yml) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
JWT_SECRET_KEY=CHANGE_ME_long_random_jwt_secret

# Public URL users open in the browser (match nginx host ports in docker-compose.server.yml)
FRONTEND_BASE_URL=http://172.16.200.30:8080

# Optional: override published ports if 8080/8443 are already taken
# SKILLVAULT_HTTP_PORT=8081
# SKILLVAULT_HTTPS_PORT=8444

POSTGRES_USER=postgres
POSTGRES_DB=techbank

# Ollama on this host (shared with other tools — read-only HTTP, no port conflict)
OLLAMA_BASE_URL=http://172.16.200.30:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_MAX_TOKENS=2000

# Restrict in production if you expose the API on other origins
CORS_ORIGINS=http://172.16.200.30:8080,https://172.16.200.30:8443

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
PORT=8000
HOST=0.0.0.0

# Optional: Microsoft Graph / Outlook sync
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# MAILBOX_EMAIL=
